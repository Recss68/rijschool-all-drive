{
	"name": "rijschool-all-drive",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"lint": "prettier --check \"**/*.{js,ts,tsx,css,svelte,json,md,yml,yaml}\" && eslint . && stylelint \"src/**/*.{css,svelte}\"",
		"lint:css": "stylelint \"src/**/*.{css,svelte}\"",
		"format": "prettier --write \"**/*.{js,ts,tsx,css,svelte,json,md,yml,yaml}\"",
		"format:check": "prettier --check \"**/*.{js,ts,tsx,css,svelte,json,md,yml,yaml}\"",
		"test": "vitest run",
		"lighthouse": "npx --yes @lhci/cli@0.16.1 autorun",
		"a11y": "npx --yes pa11y-ci@5.0.0 --sitemap \"http://localhost:${TEST_PORT:-4173}/sitemap.xml\" --sitemap-find https://www.rijschoolalldrive.nl --sitemap-replace \"http://localhost:${TEST_PORT:-4173}\"",
		"telegram:chat-id": "node scripts/telegram.mjs chat-id",
		"telegram:test": "node scripts/telegram.mjs test",
		"indexnow": "node scripts/indexnow.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^9.39.2",
		"@inlang/paraglide-js": "^2.23.2",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.50.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^22",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"fast-xml-parser": "^5.12.1",
		"globals": "^17.14.0",
		"postcss-html": "^2.0.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^3.4.1",
		"stylelint": "^17.16.0",
		"stylelint-config-html": "^2.0.0",
		"stylelint-config-recommended": "^18.0.0",
		"svelte": "^5.59.1",
		"svelte-eslint-parser": "^1.6.0",
		"vite": "^7.3.1",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@vercel/analytics": "^2.0.1",
		"gsap": "^3.15.1",
		"nodemailer": "^9.0.5"
	}
}
